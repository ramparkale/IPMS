{
  "Jwt": {
    "Key": "IPMS-SuperSecret-Key-Change-This-In-Production-2026",
    "Issuer": "IPMS.IdentityService",
    "Audience": "IPMS",
    "ExpiryMinutes": "60"
  },

  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },

      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },

      "policy-route": {
        "ClusterId": "policy-cluster",
        "Match": {
          "Path": "/api/policies/{**catch-all}"
        }
      },

      "claims-route": {
        "ClusterId": "claims-cluster",
        "Match": {
          "Path": "/api/claims/{**catch-all}"
        }
      },

      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },

      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },

      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-service": {
            "Address": "https://localhost:7001/"
          }
        }
      },

      "customer-cluster": {
        "Destinations": {
          "customer-service": {
            "Address": "https://localhost:7002/"
          }
        }
      },

      "policy-cluster": {
        "Destinations": {
          "policy-service": {
            "Address": "https://localhost:7003/"
          }
        }
      },

      "claims-cluster": {
        "Destinations": {
          "claims-service": {
            "Address": "https://localhost:7004/"
          }
        }
      },

      "payment-cluster": {
        "Destinations": {
          "payment-service": {
            "Address": "https://localhost:7005/"
          }
        }
      },

      "notification-cluster": {
        "Destinations": {
          "notification-service": {
            "Address": "https://localhost:7006/"
          }
        }
      },

      "reporting-cluster": {
        "Destinations": {
          "reporting-service": {
            "Address": "https://localhost:7007/"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}